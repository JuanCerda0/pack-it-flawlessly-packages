# Copy to .env.compose and replace these local-only placeholders before running Compose.
PACKIT_COMPOSE_DB_PASSWORD=replace-with-local-password
PACKIT_COMPOSE_RABBIT_USER=packit
PACKIT_COMPOSE_RABBIT_PASSWORD=replace-with-local-password
PACKIT_COMPOSE_RABBIT_COOKIE=replace-with-a-long-shared-cookie
# Optional on EC2: publish Paquetes, Historial and Documentos on the public interface.
# PACKIT_API_BIND_ADDRESS=0.0.0.0
# Optional: point all four APIs at another Cognito user pool.
# COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/your-pool-id
